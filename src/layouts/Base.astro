---
import { getMenuWithCacheHint, getSiteSettingsWithCacheHint } from "emdash";
import { EmDashHead, EmDashBodyStart, EmDashBodyEnd } from "emdash/ui";
import { createPublicPageContext } from "emdash/page";
import { Font } from "astro:assets";
import { resolveBlogSiteIdentity } from "../utils/site-identity";
import "../styles/nv0j.css";

interface Props {
	title: string;
	pageTitle?: string | null;
	description?: string | null;
	image?: string | null;
	canonical?: string | null;
	robots?: string | null;
	type?: "website" | "article";
	publishedTime?: string | null;
	modifiedTime?: string | null;
	author?: string | null;
	/** Landing page: no masthead or footer, vignette over the grid */
	front?: boolean;
	/** Pass content reference for plugin page contributions on content pages */
	content?: { collection: string; id: string; slug?: string | null };
}

const {
	title,
	pageTitle,
	description,
	image,
	canonical,
	robots,
	type = "website",
	publishedTime,
	modifiedTime,
	author,
	front = false,
	content,
} = Astro.props;
const [settingsResult, menuResult] = await Promise.all([
	getSiteSettingsWithCacheHint(),
	getMenuWithCacheHint("primary"),
]);
if (Astro.cache?.enabled) {
	Astro.cache.set(settingsResult.cacheHint);
	Astro.cache.set(menuResult.cacheHint);
}

const { siteTitle, siteTagline } = resolveBlogSiteIdentity(settingsResult.data);
const titleIncludesSiteName =
	title === siteTitle || title.endsWith(` – ${siteTitle}`);
const fullTitle = titleIncludesSiteName ? title : `${title} – ${siteTitle}`;

const menu = menuResult.data;

// Mirrors Hugo's IsMenuCurrent/HasMenuCurrent: log entries live at
// /YYYY/MM/DD/slug, so they light up the "Log" item too.
const path = Astro.url.pathname.replace(/\/$/, "") || "/";
function isCurrent(url: string) {
	const target = url.replace(/\/$/, "") || "/";
	if (target === "/") return path === "/";
	if (target === "/log") return path.startsWith("/log") || /^\/\d{4}\//.test(path);
	return path === target || path.startsWith(`${target}/`);
}

const pageCtx = createPublicPageContext({
	Astro,
	kind: content ? "content" : "custom",
	pageType: type,
	title: fullTitle,
	pageTitle: pageTitle ?? title,
	description: description ?? siteTagline,
	canonical,
	image,
	content,
	seo: { ogImage: image, robots },
	articleMeta: { publishedTime, modifiedTime, author },
	siteName: siteTitle,
});
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<Font cssVariable="--font-mono" preload />
		<Font cssVariable="--font-display" preload />
		<Font cssVariable="--font-body" />
		<title>{fullTitle}</title>
		<EmDashHead page={pageCtx} />
	</head>
	<body class:list={{ "nv0j-front": front }}>
		<EmDashBodyStart page={pageCtx} />

		{
			!front && (
				<header class="masthead">
					<a href="/" class="call">
						NV<span class="z">0</span>J
					</a>
					<nav class="site-nav">
						<ul>
							{menu?.items.map((item) => (
								<li>
									<a
										href={item.url}
										class:list={{ on: isCurrent(item.url) }}
										target={item.target}
										rel={item.target === "_blank" ? "noopener noreferrer" : undefined}
									>
										{item.label}
									</a>
								</li>
							))}
						</ul>
					</nav>
				</header>
			)
		}

		<main>
			<slot />
		</main>

		{
			!front && (
				<footer class="sig wrap">
					<div class="seventythree">
						<b>73</b> · NV0J
					</div>
					<div class="links">
						{menu?.items.map((item) => (
							<a href={item.url}>
								{item.label}
								<span class="arr">→</span>
							</a>
						))}
					</div>
				</footer>
			)
		}

		<EmDashBodyEnd page={pageCtx} />
	</body>
</html>
