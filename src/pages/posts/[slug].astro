---
import {
	getEmDashEntry,
	getEmDashCollection,
	getSeoMeta,
	decodeSlug,
	getSiteSettings,
} from "emdash";
import { Image, PortableText } from "emdash/ui";
import Base from "../../layouts/Base.astro";
import { resolveBlogSiteIdentity } from "../../utils/site-identity";
import { entryPath, isoDate, longDate } from "../../utils/log";

const slug = decodeSlug(Astro.params.slug);

if (!slug) {
	return Astro.redirect("/404");
}

const { entry: post, cacheHint } = await getEmDashEntry("posts", slug);

if (!post) {
	return Astro.redirect("/404");
}

if (Astro.cache?.enabled) Astro.cache.set(cacheHint);

const date = post.data.publishedAt;
const canonicalPath = entryPath(post.id);

function getImageUrl(img: unknown): string | undefined {
	if (!img || typeof img !== "object") return undefined;
	const image = img as Record<string, unknown>;
	if (typeof image.src === "string" && image.src) {
		return image.src.startsWith("http") ? image.src : `${Astro.url.origin}${image.src}`;
	}
	const meta = image.meta as Record<string, unknown> | undefined;
	const storageKey =
		(typeof meta?.storageKey === "string" ? meta.storageKey : undefined) ||
		(typeof image.id === "string" ? image.id : undefined);
	if (storageKey) {
		return `${Astro.url.origin}/_emdash/api/media/file/${storageKey}`;
	}
	return undefined;
}

const { siteTitle } = resolveBlogSiteIdentity(await getSiteSettings());
const seo = getSeoMeta(post, {
	siteTitle,
	siteUrl: Astro.url.origin,
	path: canonicalPath,
	defaultOgImage: getImageUrl(post.data.featured_image),
});

const tags = post.data.terms?.tag ?? [];

// Previous (older) / next (newer) entry, like Hugo's PrevInSection /
// NextInSection. There are no range filters, so walk the ordered list;
// fine for a personal log.
const { entries: all, cacheHint: allCacheHint } = await getEmDashCollection("posts", {
	orderBy: { published_at: "desc" },
	limit: 500,
});
if (Astro.cache?.enabled) Astro.cache.set(allCacheHint);
const index = all.findIndex((p) => p.id === post.id);
const newer = index > 0 ? all[index - 1] : undefined;
const older = index >= 0 ? all[index + 1] : undefined;
---

<Base
	title={post.data.title}
	pageTitle={seo.ogTitle}
	description={seo.description}
	image={seo.ogImage}
	canonical={seo.canonical}
	robots={seo.robots}
	type="article"
	publishedTime={date?.toISOString() ?? null}
	modifiedTime={post.data.updatedAt.toISOString()}
	author="NV0J"
	content={{ collection: "posts", id: post.data.id, slug }}
>
	<article class="article wrap">
		<header>
			<div class="eyebrow">LOG ENTRY</div>
			<h1 {...post.edit.title}>{post.data.title}</h1>
			<div class="byline">
				{
					date && (
						<>
							<time datetime={isoDate(date)}>{longDate(date)}</time>
							<span class="sep">·</span>
						</>
					)
				}
				NV0J
			</div>
		</header>

		{
			post.data.featured_image && (
				<figure class="post-hero" {...post.edit.featured_image}>
					<Image image={post.data.featured_image} />
				</figure>
			)
		}

		<div class="content">
			<PortableText value={post.data.content} />
		</div>

		<footer class="article-foot">
			{
				tags.length > 0 && (
					<div class="tags">
						{tags.map((t) => (
							<>
								<a href={`/tags/${t.slug}/`} class="chip band">
									{t.label}
								</a>{" "}
							</>
						))}
					</div>
				)
			}

			{
				(older || newer) && (
					<nav class="postnav">
						{older ? (
							<a href={entryPath(older.id)}>
								<div class="lbl">Previous Entry</div>
								<div class="ttl">{older.data.title}</div>
							</a>
						) : (
							<span />
						)}
						{newer && (
							<a href={entryPath(newer.id)} class="next">
								<div class="lbl">Next Entry</div>
								<div class="ttl">{newer.data.title}</div>
							</a>
						)}
					</nav>
				)
			}
		</footer>
	</article>
</Base>
