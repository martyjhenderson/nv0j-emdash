---
import { getTaxonomyTermsWithCacheHint, getEmDashCollection, decodeSlug } from "emdash";
import Base from "../../layouts/Base.astro";
import { entryPath, isoDate, shortDate } from "../../utils/log";

const slug = decodeSlug(Astro.params.slug);
const termsResult = await getTaxonomyTermsWithCacheHint("tag", { includeCounts: false });
const term = slug ? termsResult.data.find((item) => item.slug === slug) : null;

if (!term) {
	return Astro.redirect("/404");
}

const cursor = Astro.url.searchParams.get("cursor") || undefined;
const {
	entries: posts,
	cacheHint,
	nextCursor,
} = await getEmDashCollection("posts", {
	where: { tag: term.slug },
	orderBy: { published_at: "desc" },
	limit: 20,
	cursor,
});

if (Astro.cache?.enabled) {
	Astro.cache.set(termsResult.cacheHint);
	Astro.cache.set(cacheHint);
}
---

<Base title={term.label} description={`Log entries tagged ${term.label}`}>
	<div class="wrap">
		<header class="log-head">
			<div class="eyebrow">Tagged <span class="rule"></span></div>
			<h1>{term.label}</h1>
		</header>
		<section class="entries">
			{
				posts.map((post) => {
					const date = post.data.publishedAt;
					return (
						<article class="entry">
							<aside class="rail">
								{date && (
									<time class="date" datetime={isoDate(date)}>
										{shortDate(date)}
									</time>
								)}
							</aside>
							<div class="body">
								<h2>
									<a href={entryPath(post.id, date)}>{post.data.title}</a>
								</h2>
								{post.data.excerpt && <div class="excerpt">{post.data.excerpt}</div>}
							</div>
						</article>
					);
				})
			}
		</section>

		{
			nextCursor && (
				<nav class="pager">
					<span />
					<a href={`/tags/${term.slug}/?cursor=${encodeURIComponent(nextCursor)}`}>
						Older entries →
					</a>
				</nav>
			)
		}
	</div>
</Base>
