---
// Old Hugo-style permalink: /YYYY/MM/DD/<slug>/ → /posts/<slug>. The date
// segments are ignored; the slug is the key.
import { getEmDashEntry, decodeSlug } from "emdash";
import { entryPath } from "../../../../utils/log";

const slug = decodeSlug(Astro.params.slug);
const { entry: post } = slug ? await getEmDashEntry("posts", slug) : { entry: null };

if (!post) {
	return Astro.redirect("/404");
}

return Astro.redirect(entryPath(post.id), 301);
---
