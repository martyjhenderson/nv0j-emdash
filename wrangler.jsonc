{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "nv0j-emdash",
	"main": "./src/worker.ts",
	"compatibility_date": "2026-02-24",
	"compatibility_flags": ["nodejs_compat"],
	"vars": { "EMDASH_SITE_URL": "https://nv0j-emdash.ravegrunt.workers.dev" },
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "nv0j-emdash-db","database_id": "f2222b30-145e-4171-9195-a5d205d0b7ef",
		},
	],
	"r2_buckets": [
		{
			"binding": "MEDIA",
			"bucket_name": "nv0j-emdash-media","preview_bucket_name": "nv0j-emdash-media",
		},
	],
	// Sandboxed plugins require Worker Loader, available on Workers paid plans. Uncomment to enable:
	// "worker_loaders": [{ "binding": "LOADER" }],
	// General maintenance cron trigger
	"triggers": {
		"crons": ["* * * * *"],
	},
}
